fn pow(value: number) -> number {
    return value * value;
}

fn scale(value: number, factor: number) -> number {
    return value * factor;
}

fn factorial(value: number) -> number
    requires value > 1 {
    let from_to = value..=1 by -1;
    let acc = 1;

    for value in from_to {
        acc *= value;
    }

    return acc;
}

fn sum(x: number, y: number) -> number {
    return x + y;
}

fn main() -> number {
    let numb = 2;
    let result =
    numb
    |> scale(factor: 2)
    |> sum(y: 1)
    |> factorial;

    return result;
}
