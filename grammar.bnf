<program> ::= <ws> <function_list> <ws>

<function_list> ::= <function> ( <ws> <function> )*

<function> ::= "fn" <ws1> <identifier> <ws>
               "(" <ws> <parameter_list>? <ws> ")"
               <ws> "->" <ws> <type>
               <ws> <block>

<parameter_list> ::= <parameter> ( <ws> "," <ws> <parameter> )*

<parameter> ::= <identifier> <ws> ":" <ws> <type>
                 ( <ws> "=" <ws> <expression> )?

# Defaults are trailing-only and declaration-checked against the pure-expression
# whitelist. They read only earlier formals and retain mandatory parameter types.
# Source omission does not change the full-arity raw exported signature.


<type> ::= "number" <array_type_suffix>?
         | "bool"
         | "string"
         | "range"
         | "void"

<array_type_suffix> ::= "[" <ws> "]"


<block> ::= "{" <ws> <statement_list>? <ws> "}"

<statement_list> ::= <statement> ( <ws> <statement> )*


<statement> ::= <variable_declaration>
              | <assignment>
              | <compound_assignment>
              | <if_statement>
              | <while_statement>
              | <for_statement>
              | <loop_statement>
              | <break_statement>
              | <continue_statement>
              | <return_statement>
              | <expression_statement>


<variable_declaration> ::= "let" <ws1> <identifier>
                           ( <ws> ":" <ws> <type> )?
                           <ws> "=" <ws> <expression>
                           <ws> ";"


<assignment> ::= <identifier> <ws> "=" <ws> <expression> <ws> ";"
               | <array_access> <ws> "=" <ws> <expression> <ws> ";"


<compound_assignment> ::= <identifier> <ws> <compound_assignment_operator>
                          <ws> <expression> <ws> ";"
                         | <array_access> <ws> <compound_assignment_operator>
                          <ws> <expression> <ws> ";"

<compound_assignment_operator> ::= "+=" | "-=" | "*=" | "/=" | "%="

# Compound assignment is statement-only. Targets and RHS must have type number;
# array-element targets use an identifier-rooted number[] base and number index.
# Each compound operator is one contiguous token; trivia cannot split its bytes.


<if_statement> ::= "if" <ws1> <expression>
                   <ws> <value_block>
                   ( <ws> "else" <ws> ( <value_block> | <if_statement> ) )?

<value_block> ::= "{" <ws> <statement_list>? <ws> <expression>? <ws> "}"

<if_expression> ::= "if" <ws1> <expression> <ws> <value_block>
                    ( <ws> "else" <ws> ( <value_block> | <if_expression> ) )?

# A value block's final expression has no semicolon. A semicolon discards its
# result. Nonfinal bare if/loop forms can separate statements without a semicolon;
# all other adjacent expressions require explicit semicolons, regardless of lines.
# A final bare if/loop in a value block is its expression tail. A value if requires
# else semantically. Bare loop with a semicolon is a statement loop in all statement
# positions, including value blocks; `(loop { break 1; });` discards a value loop.
# In statement position and when classifying value-block statements/tails, a bare
# if ends at its last arm and loop at its closing brace, before any following
# binary operator. Thus
# `if true {} -1;` and `if true {} --1;` contain two statements, with or without
# else, independent of whitespace/comments. Parenthesize the whole if for binary
# continuation there: `(if true { 1 } else { 2 }) - 1;` (or a block tail without `;`).
# Ordinary value contexts such as initializers, returns, arguments, and operands
# still allow `if true { 1 } else { 2 } - 1` without whole-if parentheses.
# A semicolon immediately after a bare if makes it an expression statement.
# Statement-if branch tails are discarded, including nested statement else-if.
# Every expression-form if requires else and exactly matching arm results, with
# divergent Never arms compatible with the other result. Never is not a source type.
# Function, while, for, and loop bodies remain strict statement blocks: ordinary tails
# need semicolons. A loop expression gets its result only from reachable breaks.
# Named functions never implicitly return a tail; nonvoid functions must return
# or explicitly diverge on every path, never complete normally.


<while_statement> ::= "while" <ws1> <expression>
                      <ws> <block>


<for_statement> ::= "for" <ws1> <identifier> <ws1> "in" <ws1> <expression>
                    <ws> <block>

# For is statement-only, including when final in a value block, and accepts only
# range or number[] iterables with Never compatibility. Analyze/evaluate the iterable
# once in the enclosing context before activating the for or binding its name.
# Iterable return/divergence and transfers to enclosing loops are preserved.
# The iteration binding is a read-only number in a scope outside the body; an
# inner let may shadow it with a distinct mutable binding. All bodies are checked,
# including empty iteration and unreachable writes/transfers. For may execute zero
# times. Continue advances before retesting; bare break exits; value break is invalid.
# Arrays capture handle and u32 length once after full validation, including empty
# arrays; unsigned index iteration loads each current element through checked
# ArrayAddress. Alias mutations are visible; source reassignment does not replace
# the captured handle. There is no element snapshot or parser/AST shape change.
# for is reserved for source and host-language names, not host module/field names.

<loop_statement> ::= "loop" <ws> <block> ( <ws> ";" )?

<loop_expression> ::= "loop" <ws> <block>

<break_statement> ::= "break" <ws> ";"
                    | "break" <ws> <expression> <ws> ";"

<continue_statement> ::= "continue" <ws> ";"

# Loop transfers are statement-only, without labels, and target the nearest
# enclosing while/for/loop in the same function. Statement loops, while, and for
# accept only bare break; value loops require a nonvoid break value, even in
# unreachable code.
# Reachable value breaks must have exactly matching types. No reachable exit gives
# Never; divergent RHS expressions do not supply an actual break result.
# loop, break, and continue are reserved keywords.


<return_statement> ::= "return" <ws> ";"
                     | "return" <ws1> <expression> <ws> ";"


<expression_statement> ::= <expression> <ws> ";"


<expression> ::= <logical_or_expression>


<logical_or_expression> ::= <logical_and_expression>
                            ( <ws> "||" <ws> <logical_and_expression> )*


<logical_and_expression> ::= <equality_expression>
                             ( <ws> "&&" <ws> <equality_expression> )*


<equality_expression> ::= <comparison_expression>
                          ( <ws> <equality_operator>
                            <ws> <comparison_expression> )*

<equality_operator> ::= "==" | "!="


<comparison_expression> ::= <range_expression>
                            ( <ws> <comparison_operator>
                              <ws> <range_expression> )*

<comparison_operator> ::= "<"
                        | "<="
                        | ">"
                        | ">="
                        | "in"


<range_expression> ::= <additive_expression>
                        ( <ws> ( ".." | "..=" ) <ws> <additive_expression>
                          ( <ws> "by" <ws> <additive_expression> )? )?

# Range construction is non-associative; parenthesized ranges are syntactically
# valid operands but semantic analysis requires numeric endpoints and steps.
# by is an ordinary identifier except when attaching a step after a range endpoint.
# range is a reserved type keyword. Range == and != are semantic errors.
# Ranges support internal parameters/results but not host imports or selected user
# exports. Use explicit export selection for programs with internal range helpers.
# Construction, membership, and range/number[] statement for are implemented WP5;
# allocation-free range representation and a public range ABI are not implied.
# in is reserved and tests number-in-range membership, producing bool with exact
# operand types and Never compatibility. Both operands are checked even when
# unreachable or skipped; evaluation sequences the candidate before the range.
# Comparison operators, including in, are left-associative.
# Recognize ..= before .. and stop numeric scanning before either token; other
# malformed decimals remain invalid. Range punctuation must be contiguous.


<additive_expression> ::= <multiplicative_expression>
                          ( <ws> <additive_operator>
                            <ws> <multiplicative_expression> )*

<additive_operator> ::= "+"
                      | "-"


<multiplicative_expression> ::= <unary_expression>
                                ( <ws> <multiplicative_operator>
                                  <ws> <unary_expression> )*

<multiplicative_operator> ::= "*"
                            | "/"
                            | "%"


<unary_expression> ::= <postfix_expression>
                     | "!" <ws> <unary_expression>
                     | "-" <ws> <unary_expression>


<postfix_expression> ::= <identifier> <ws> "(" <ws> <argument_list>? <ws> ")"
                       | <identifier> <ws> "[" <ws> <expression> <ws> "]"
                       | <primary_expression>


<primary_expression> ::= <number_literal>
                       | <string_literal>
                       | <boolean_literal>
                       | <identifier>
                       | <array_literal>
                       | <value_block>
                       | <if_expression>
                       | <loop_expression>
                       | "(" <ws> <expression> <ws> ")"


<argument_list> ::= <argument>
                    ( <ws> "," <ws> <argument> )*

<argument> ::= ( <identifier> <ws> ":" <ws> )? <expression>

# Named arguments target user functions only. Positionals form an initial prefix;
# subsequent arguments must be named. All formals are supplied exactly once with
# exact types. Explicit expressions evaluate once in written order; the direct
# machine call remains full-arity in formal order. Defaults remain unsupported.


<array_access> ::= <identifier>
                   <ws> "["
                   <ws> <expression>
                   <ws> "]"


<array_literal> ::= "[" <ws> <expression_list>? <ws> "]"

<expression_list> ::= <expression>
                      ( <ws> "," <ws> <expression> )*


<boolean_literal> ::= "true"
                    | "false"


<identifier> ::= <identifier_start> <identifier_rest>*

<identifier_start> ::= [a-z]
                     | [A-Z]
                     | "_"

<identifier_rest> ::= <identifier_start>
                    | [0-9]


<number_literal> ::= <integer_literal>
                   | <decimal_literal>

<integer_literal> ::= [0-9]+

<decimal_literal> ::= [0-9]+ "." [0-9]+


<string_literal> ::= "\"" <string_character>* "\""

<string_character> ::= [a-z]
                     | [A-Z]
                     | [0-9]
                     | " "
                     | "_"
                     | "-"
                     | "."
                     | ","
                     | "!"
                     | "?"


<ws> ::= <trivia>*

<ws1> ::= <trivia>+

<trivia> ::= <whitespace_character>
           | <line_comment>
           | <block_comment>

<whitespace_character> ::= " "
                         | "\n"
                         | "\t"

<line_comment> ::= "//" [^\r\n]* ( "\n" | "\r" | <eof> )

<block_comment> ::= "/*" <block_comment_part>* "*"+ "/"

<block_comment_part> ::= [^*]
                       | "*"+ [^*/]

# Lexical notes: <eof> is a zero-width end-of-input assertion, not source text.
# Block-comment parts cannot consume "*/", so the first "*/" closes the comment;
# "/*" inside a block comment is ordinary content (no nesting).
# Comments are trivia only between tokens; delimiters in strings remain text.
# Skipping comments preserves byte spans and never joins identifier/operator bytes.
# An unterminated block emits Invalid from the opening slash to EOF, then Eof;
# existing parser errors report it, with no new error stage.
